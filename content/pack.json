      "rewardXpMin": 20,
      "rewardXpMax": 40,
      "offerTexts": [
        "They breed faster than we bury them. Thin their numbers.",
        "Every one you drop is a door we don't barricade."
      ],
      "completeTexts": [
        "The halls breathe easier. Take this.",
        "Well struck. The watch remembers."
      ]
    },
